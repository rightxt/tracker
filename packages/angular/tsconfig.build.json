{
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true
  },
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "experimentalDecorators": true,
    "module": "ES2022",
    "noEmit": false,
    "outDir": "./dist",
    "paths": {
      "@rightxt/tracker-core": ["../../packages/core/dist/index.d.ts"],
      "@rightxt/tracker-core/projection": ["../../packages/core/dist/projection.d.ts"]
    },
    "rootDir": "./src",
    "sourceMap": true,
    "useDefineForClassFields": false
  },
  "exclude": ["./dist", "./src/__tests__", "node_modules"],
  "extends": "../../tsconfig.json",
  "include": ["./src/**/*.ts"]
}
