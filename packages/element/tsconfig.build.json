{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist",
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "paths": {
      "@rightxt/tracker-core": ["../../packages/core/dist/index.d.ts"],
      "@rightxt/tracker-core/advanced": ["../../packages/core/dist/advanced.d.ts"],
      "@rightxt/tracker-core/advanced/debug": ["../../packages/core/dist/advanced.d.ts"],
      "@rightxt/tracker-core/debug": ["../../packages/core/dist/index.d.ts"],
      "@rightxt/tracker-core/projection": ["../../packages/core/dist/projection.d.ts"],
      "@rightxt/tracker-core/projection/debug": ["../../packages/core/dist/projection.d.ts"],
      "@rightxt/tracker-core/renderer": ["../../packages/core/dist/renderer.d.ts"],
      "@rightxt/tracker-core/renderer/debug": ["../../packages/core/dist/renderer.d.ts"]
    },
    "rootDir": "./src"
  },
  "exclude": ["./dist", "./src/**/__tests__/**", "node_modules"],
  "extends": "../../tsconfig.json",
  "include": ["./src/**/*.ts"]
}
