  "scripts": {
    "benchmarks:run": "node benchmarks/run-all.mjs",
    "benchmarks:test": "vitest run --config vitest.benchmarks.config.mjs",
    "clean": "node scripts/clean.mjs",
    "eslint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "packages:build": "node build.js",
    "packages:metadata:check": "node scripts/sync-package-metadata.mjs --check",
    "packages:metadata:sync": "node scripts/sync-package-metadata.mjs",
    "packages:test": "vitest run",
    "packages:test:browser:chromium": "vitest run --config vitest.browser.config.mjs --browser.name=chromium",
    "packages:test:browser:firefox": "vitest run --config vitest.browser.config.mjs --browser.name=firefox",
    "packages:test:browser:webkit": "vitest run --config vitest.browser.config.mjs --browser.name=webkit",
    "packages:test:coverage": "vitest run --coverage",
    "packages:verify:dist": "node scripts/verify-dist.mjs",
    "packages:verify:pack": "node scripts/verify-pack.mjs",
    "release:verify:metadata": "node scripts/verify-release-metadata.mjs",
    "site:build": "node site/scripts/build.mjs --mode=production",
    "site:build:dev": "node site/scripts/build.mjs --mode=dev",
    "site:serve:dev": "node site/scripts/serve.mjs",
    "site:test": "vitest run --config site/vitest.config.mjs",
    "site:test:browser:chromium": "node site/scripts/test-browser.mjs --browser=chromium",
    "stylelint": "stylelint \"**/*.css\"",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "type": "module",
  "version": "1.0.0"
