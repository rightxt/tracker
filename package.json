    "eslint-plugin-jsdoc": "^64.3.9",
    "eslint-plugin-react": "7.37.5",
    "github-slugger": "2.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "marked": "18.0.12",
    "playwright": "1.61.1",
    "prettier": "^3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.51.2",
